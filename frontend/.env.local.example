# PanenCerdas Frontend — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).

# Express gateway base URL
NEXT_PUBLIC_API_URL=http://localhost:4200

# Supabase (Project Settings -> API). The anon key is public/safe — RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

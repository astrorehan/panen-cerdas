# PanenCerdas Frontend — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).

# Express gateway base URL — dipakai untuk mutasi (predict, feedback, edit lahan).
NEXT_PUBLIC_API_URL=http://localhost:4200

# FastAPI ML service base URL — dipakai untuk SEMUA GET (dashboard, produksi,
# analisis, lahan, riwayat) supaya melewati Express (buang 1 hop + 1 cold start).
# Dev: boleh dikosongkan -> otomatis fallback ke NEXT_PUBLIC_API_URL di atas.
# Prod: isi URL FastAPI langsung, mis. https://panen-cerdas-ml.onrender.com
NEXT_PUBLIC_ML_URL=

# Supabase (Project Settings -> API). The anon key is public/safe — RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
